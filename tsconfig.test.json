{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rootDir": ".",
		"outDir": ".test-out",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": [
		"apps/desktop/main/**/*.test.ts",
		"apps/desktop/renderer/global.d.ts",
		"apps/desktop/renderer/**/*.test.ts",
		"packages/**/*.test.ts",
		"packages/**/*.test.tsx"
	]
}
