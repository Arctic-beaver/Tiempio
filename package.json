		"@electron-toolkit/tsconfig": "2.0.0",
		"@types/node": "22.20.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.2.0",
		"electron": "43.2.0",
