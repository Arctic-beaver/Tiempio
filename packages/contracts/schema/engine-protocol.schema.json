		"transport.loop",
		"synth.bass.deep",
		"audition.notes",
		"diagnostics.health",
		"render.offline"
	],
	"commands": [
		"handshake",
		"configure-audio",
		"start-audio",
		"stop-audio",
		"load-render-plan",
		"apply-render-plan-delta",
		"play",
		"stop",
		"seek",
		"set-loop",
		"note-on",
		"note-off",
		"preview-macro",
		"commit-macro",
