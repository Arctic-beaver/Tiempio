{
	"schemaVersion": 1,
	"engineProtocolVersion": 1,
	"limits": {
		"maxFrameBytes": 262144,
		"maxPayloadBytes": 196608,
		"maxIdentifierBytes": 128,
		"maxBatchItems": 4096
	},
	"commands": [
		"handshake",
		"configure-audio",
		"start-audio",
		"stop-audio",
		"load-render-plan",
		"apply-render-plan-delta",
		"play",
		"stop",
		"seek",
		"set-loop",
		"note-on",
		"note-off",
		"preview-macro",
		"commit-macro",
		"request-diagnostics",
		"refresh-devices",
		"start-offline-render",
		"cancel-offline-render",
		"shutdown"
	],
	"events": [
		"ready",
		"capabilities",
		"render-plan-acknowledged",
		"transport-snapshot",
		"meter-snapshot",
		"active-device-changed",
		"midi-captured",
		"diagnostic",
		"offline-render-progress",
		"offline-render-completed",
		"fatal-error"
	],
	"diagnosticCodes": [
		"protocol.version-mismatch",
		"protocol.frame-too-large",
		"protocol.invalid-envelope",
		"engine.unavailable",
		"audio.suspended",
		"audio.device-unavailable",
		"audio.output-muted",
		"audio.render-overload"
	]
}
